{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "test": "node --import tsx --test test/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "tsc --project tsconfig.standalone.json && npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "acorn": "^8.15.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
