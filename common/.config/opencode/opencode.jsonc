{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "654819000882.11834712114181",
          "client_secret": "{env:SLACK_MCP_CLIENT_SECRET}",
          "callback_port": 3118,
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  }
}
