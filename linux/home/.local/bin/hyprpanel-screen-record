#!/usr/bin/env bash

set -euo pipefail

upstream_script="/usr/share/hyprpanel/scripts/screen_record.sh"

if [[ "${1:-}" != "stop" ]]; then
    exec "$upstream_script" "$@"
fi

if ! pgrep -x wf-recorder >/dev/null; then
    echo "No recording in progress."
    exit 1
fi

pkill -SIGINT -x wf-recorder
for _ in {1..20}; do
    pgrep -x wf-recorder >/dev/null || break
    sleep 0.1
done

output_path="$(cat /tmp/last_recording_path 2>/dev/null || true)"
if [[ -z "$output_path" || ! -f "$output_path" ]]; then
    notify-send "Recording stopped" "No recent recording found." \
        -i video-x-generic \
        -a "Screen Recorder" \
        -t 10000
    exit 1
fi

notify-send "Recording stopped" "Saved to: $output_path" \
    -i video-x-generic \
    -a "Screen Recorder" \
    -t 10000 \
    --action="scriptAction:-$HOME/.local/bin/hyprpanel-recording-action directory=Open Directory" \
    --action="scriptAction:-$HOME/.local/bin/hyprpanel-recording-action play=Play"
