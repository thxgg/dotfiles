#!/usr/bin/env bash
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
state_file="$state_dir/wallpaper"

current_uri() {
  local mode uri
  mode="$($HOME/.local/bin/theme-mode get 2>/dev/null || printf dark)"
  if [[ "$mode" == dark ]]; then
    uri="$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null || true)"
  else
    uri="$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || true)"
  fi
  uri="${uri#\'}"
  printf '%s\n' "${uri%\'}"
}

apply_uri() {
  local uri="$1"
  local wallpaper

  [[ "$uri" == file://* ]] || return 0
  wallpaper="$(python - "$uri" <<'PY'
import sys
from urllib.parse import unquote, urlparse

print(unquote(urlparse(sys.argv[1]).path))
PY
)"
  [[ -f "$wallpaper" ]] || return 0

  mkdir -p "$state_dir"
  printf '%s\n' "$wallpaper" > "$state_file"
  "$HOME/.local/bin/theme-mode" --quiet --force apply
}

last_uri="$(current_uri)"
while sleep 1; do
  uri="$(current_uri)"
  if [[ -n "$uri" && "$uri" != "$last_uri" ]]; then
    apply_uri "$uri"
    last_uri="$uri"
  fi
done
