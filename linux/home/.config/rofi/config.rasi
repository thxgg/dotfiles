configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{icon} {name}";
    display-drun: " Apps ";
    sidebar-mode: false;
    disable-history: false;
    hide-scrollbar: true;
}

window {
    width: 38%;
    border-radius: 12px;
}

inputbar {
    padding: 10px;
}

listview {
    lines: 10;
    columns: 1;
}

element {
    padding: 8px;
    border-radius: 8px;
}

element-icon {
    size: 1.1em;
}

@theme "catppuccin-light"

mainbox {
    children: [ "inputbar", "message", "listview" ];
}
